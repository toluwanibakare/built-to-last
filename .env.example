# Copy this file to `.env` and fill in your values.
# Never commit your real `.env` file.

# ---- Public site ----
VITE_CONTACT_EMAIL=hello@built-to-last.example

# ---- Pre-order pricing (set before going live) ----
# Book price in the currency below. Use 0 until pricing is finalised.
VITE_BOOK_PRICE=0
VITE_SHIPPING_COST=0
VITE_CURRENCY=NGN
VITE_PRICE_LABEL=To be announced

# ---- Korapay ----
# Public key is safe for client-side use. Obtain it from the Korapay dashboard
# (https://merchant.korapay.com/dashboard/settings/api-integrations).
# Test keys start with pk_test_, live keys with pk_live_.
VITE_KORAPAY_PUBLIC_KEY=pk_test_placeholder

# ---- Backend API (optional for now) ----
# Base URL of your serverless function / backend. Order creation and payment
# verification must run server-side with your Korapay secret key.
VITE_API_BASE_URL=

# ---- Social media (URLs to be added later) ----
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
